<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/wl_ripple">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="@color/wl_purple_surface" />
                    <stroke android:width="1dp" android:color="@color/wl_purple" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/wl_header_button" />
                    <stroke android:width="1dp" android:color="@color/wl_card_border" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
