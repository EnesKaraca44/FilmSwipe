<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_host"
    app:startDestination="@id/anaMenuFragment">

    <fragment
        android:id="@+id/anaMenuFragment"
        android:name="com.enes.movyswipe.fragments.AnaMenuFragment"
        android:label="fragment_ana_menu"
        tools:layout="@layout/fragment_ana_menu" >
        <action
            android:id="@+id/action_anaMenuFragment_to_filtreFragment"
            app:destination="@id/filtreFragment" />
        <action
            android:id="@+id/action_anaMenuFragment_to_odayaKatilFragment"
            app:destination="@id/odayaKatilFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in" />
        <action
            android:id="@+id/action_anaMenuFragment_to_hizliDuelloBeklemeFragment"
            app:destination="@id/hizliDuelloBeklemeFragment" />
        <action
            android:id="@+id/action_anaMenuFragment_to_ayarlarFragment"
            app:destination="@id/ayarlarFragment" />
        <action
            android:id="@+id/action_anaMenuFragment_to_izlemeListesiFragment"
            app:destination="@id/izlemeListesiFragment" />
        <action
            android:id="@+id/action_anaMenuFragment_to_profilOlusturFragment"
            app:destination="@id/profilOlusturFragment" />
    </fragment>
    <fragment
        android:id="@+id/duelloFragment"
        android:name="com.enes.movyswipe.fragments.DuelloFragment"
        android:label="fragment_duello"
        tools:layout="@layout/fragment_duello" >
        <action
            android:id="@+id/action_duelloFragment_to_eslemeFragment"
            app:destination="@id/eslemeFragment"
            app:enterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out"
            app:popUpTo="@id/duelloFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_duelloFragment_to_eslemeYokFragment"
            app:destination="@id/eslemeYokFragment"
            app:popUpTo="@id/duelloFragment"
            app:popUpToInclusive="true" />
        <argument
            android:name="roomCode"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/eslemeFragment"
        android:name="com.enes.movyswipe.fragments.EslemeFragment"
        android:label="fragment_esleme"
        tools:layout="@layout/fragment_esleme" >
        <action
            android:id="@+id/action_eslemeFragment_to_sohbetFragment"
            app:destination="@id/sohbetFragment" />
        <argument
            android:name="matchedMovieId"
            app:argType="integer" />
        <argument
            android:name="roomCode"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/eslemeYokFragment"
        android:name="com.enes.movyswipe.fragments.EslemeYokFragment"
        android:label="fragment_esleme_yok"
        tools:layout="@layout/fragment_esleme_yok" >
        <action
            android:id="@+id/action_eslemeYokFragment_to_anaMenuFragment"
            app:destination="@id/anaMenuFragment" />
        <action
            android:id="@+id/action_eslemeYokFragment_to_filtreFragment"
            app:destination="@id/filtreFragment" />
        <action
            android:id="@+id/action_eslemeYokFragment_to_hizliDuelloBeklemeFragment"
            app:destination="@id/hizliDuelloBeklemeFragment" />
    </fragment>
    <fragment
        android:id="@+id/filtreFragment"
        android:name="com.enes.movyswipe.fragments.FiltreFragment"
        android:label="fragment_filtre"
        tools:layout="@layout/fragment_filtre" >
        <action
            android:id="@+id/action_filtreFragment_to_odaKoduFragment"
            app:destination="@id/odaKoduFragment" />
    </fragment>
    <fragment
        android:id="@+id/hizliDuelloBeklemeFragment"
        android:name="com.enes.movyswipe.fragments.HizliDuelloBeklemeFragment"
        android:label="fragment_hizli_duello_bekleme"
        tools:layout="@layout/fragment_hizli_duello_bekleme" >
        <action
            android:id="@+id/action_hizliDuelloBeklemeFragment_to_duelloFragment"
            app:destination="@id/duelloFragment" />
        <action
            android:id="@+id/action_hizliDuelloBeklemeFragment_to_anaMenuFragment"
            app:destination="@id/anaMenuFragment"
            app:popUpTo="@id/anaMenuFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/odaKoduFragment"
        android:name="com.enes.movyswipe.fragments.OdaKoduFragment"
        android:label="fragment_oda_kodu"
        tools:layout="@layout/fragment_oda_kodu" >
        <action
            android:id="@+id/action_odaKoduFragment_to_duelloFragment"
            app:destination="@id/duelloFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/fade_in"
            app:popUpTo="@id/filtreFragment"
            app:popUpToInclusive="true" />
        <argument
            android:name="genres"
            app:argType="integer[]" />
        <argument
            android:name="StartYear"
            app:argType="integer"
            android:defaultValue="1980" />
    </fragment>
    <fragment
        android:id="@+id/odayaKatilFragment"
        android:name="com.enes.movyswipe.fragments.OdayaKatilFragment"
        android:label="fragment_odaya_katil"
        tools:layout="@layout/fragment_odaya_katil" >
        <action
            android:id="@+id/action_odayaKatilFragment_to_duelloFragment"
            app:destination="@id/duelloFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_right" />
    </fragment>
    <fragment
        android:id="@+id/sohbetFragment"
        android:name="com.enes.movyswipe.fragments.SohbetFragment"
        android:label="fragment_sohbet"
        tools:layout="@layout/fragment_sohbet" >
        <argument
            android:name="roomCode"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/ayarlarFragment"
        android:name="com.enes.movyswipe.fragments.AyarlarFragment"
        android:label="fragment_ayarlar"
        tools:layout="@layout/fragment_ayarlar" />
    <fragment
        android:id="@+id/profilOlusturFragment"
        android:name="com.enes.movyswipe.fragments.ProfilOlusturFragment"
        android:label="fragment_profil_olustur"
        tools:layout="@layout/fragment_profil_olustur" >
        <action
            android:id="@+id/action_profilOlusturFragment_to_anaMenuFragment"
            app:destination="@id/anaMenuFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.enes.movyswipe.fragments.SplashFragment"
        android:label="SplashFragment" >
        <action
            android:id="@+id/action_splashFragment_to_anaMenuFragment"
            app:destination="@id/anaMenuFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splashFragment_to_profilOlusturFragment"
            app:destination="@id/profilOlusturFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/izlemeListesiFragment"
        android:name="com.enes.movyswipe.fragments.IzlemeListesiFragment"
        android:label="fragment_izleme_listesi"
        tools:layout="@layout/fragment_izleme_listesi" />
</navigation>