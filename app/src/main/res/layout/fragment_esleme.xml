<?xml version="1.0" encoding="utf-8"?>
<!-- 1. En dıştaki kabı ScrollView yapıyoruz. Bu, içeriğin kaydırılmasını sağlar. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/light_gradient_background"
    tools:context=".fragments.EslemeFragment">

    <!-- 2. ScrollView'ın içine, senin orijinal LinearLayout tasarımını koyuyoruz.
         'height'ını "wrap_content" yapıyoruz ki içeriği kadar uzayabilsin. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Başarı Animasyonu -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieAnimationView"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_marginBottom="24dp"
            app:lottie_autoPlay="true"
            app:lottie_loop="false"
            app:lottie_rawRes="@raw/match_animation" />

        <!-- Film Bilgisi Kartı -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface_light"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Film Posteri -->
                <ImageView
                    android:id="@+id/ivEslesenFilmPoster"
                    android:layout_width="180dp"
                    android:layout_height="240dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/bg_medium"
                    android:elevation="4dp"
                    android:scaleType="centerCrop"
                    tools:src="@tools:sample/avatars" />

                <!-- Film Adı -->
                <TextView
                    android:id="@+id/tvEslesenFilmAdi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:text="Eşleşen Film" />

                <!-- Film Detayları -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvEslesenFilmYili"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="16sp"
                        tools:text="📅 2023" />

                    <TextView
                        android:id="@+id/tvEslesenFilmPuani"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent_medium"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="⭐ 8.5" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Kutlama Mesajı -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="🎊 Harika! 🎊"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.9"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="İkiniz de aynı filmi beğendiniz!\nBu filmi izleme zamanı!"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Sohbet ve Listeme Ekle Butonları -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnSohbetEt"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/button_primary"
                    android:elevation="8dp"
                    android:text="💬 SOHBET ET"
                    android:textColor="@color/text_white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnListemeEkle"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/button_secondary"
                    android:elevation="8dp"
                    android:text="⭐ LİSTEME EKLE"
                    android:textColor="@color/text_white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Diğer butonların aynı kalacak -->

        </LinearLayout>

    </LinearLayout>

</ScrollView>