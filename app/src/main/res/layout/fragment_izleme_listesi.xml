<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/watchlist_gradient_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    tools:context=".fragments.IzlemeListesiFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="24dp">

        <!-- ====== BAŞLIK ====== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="İzleme Listesi"
                        android:textColor="@color/wl_text_primary"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginStart="7dp"
                        android:layout_marginTop="3dp"
                        android:background="@drawable/watchlist_title_dot" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAltBaslik"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/wl_text_muted"
                    android:textSize="11sp"
                    tools:text="FilmSwipe Ortak Arşiv • v1.0.10" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnAra"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/watchlist_icon_circle"
                android:contentDescription="Listede ara"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_wl_search"
                app:tint="@color/wl_text_primary" />

            <ImageButton
                android:id="@+id/btnFiltrele"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/watchlist_icon_circle"
                android:contentDescription="Sırala"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_wl_tune"
                app:tint="@color/wl_text_primary" />
        </LinearLayout>

        <!-- ====== ARAMA ÇUBUĞU (arama butonuyla açılır) ====== -->
        <LinearLayout
            android:id="@+id/layoutArama"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/watchlist_search_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="6dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wl_search"
                app:tint="@color/wl_text_muted" />

            <EditText
                android:id="@+id/etArama"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Listende film ara"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/wl_text_primary"
                android:textColorHint="@color/wl_text_muted"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnAramaKapat"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Aramayı kapat"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_wl_close"
                app:tint="@color/wl_text_muted" />
        </LinearLayout>

        <!-- ====== BOŞ DURUM KARTI ====== -->
        <LinearLayout
            android:id="@+id/cardEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/watchlist_card_background"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="30dp"
            android:paddingBottom="22dp"
            android:visibility="gone"
            tools:visibility="visible">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp">

                <ImageView
                    android:layout_width="66dp"
                    android:layout_height="66dp"
                    android:layout_gravity="bottom|start"
                    android:background="@drawable/watchlist_empty_icon_bg"
                    android:importantForAccessibility="no"
                    android:padding="17dp"
                    android:src="@drawable/ic_wl_film"
                    app:tint="@color/wl_purple_light" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/watchlist_empty_icon_dot" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Henüz film eklenmemiş"
                android:textColor="@color/wl_text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="Eşleştiğiniz filmler ve arkadaşlarınızla ortak beğendiğiniz tüm sinema yapımları burada listelenir."
                android:textColor="@color/wl_text_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/btnDuelloBaslat"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/watchlist_cta_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_wl_bolt"
                    app:tint="@color/wl_cta_icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Düello Başlat &amp; Film Eşle"
                    android:textColor="@color/wl_on_accent"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ====== FİLMLERİM ====== -->
        <LinearLayout
            android:id="@+id/layoutListeBaslik"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvListeBaslik"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.06"
                android:textColor="@color/wl_label"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="FİLMLERİM (3)" />

            <LinearLayout
                android:id="@+id/btnSiralama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp"
                android:paddingStart="6dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_wl_sort"
                    app:tint="@color/wl_purple_light" />

                <TextView
                    android:id="@+id/tvSiralama"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:textColor="@color/wl_purple_light"
                    android:textSize="12sp"
                    tools:text="En yeni eklenen" />
            </LinearLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewFilmler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:nestedScrollingEnabled="false"
            android:visibility="gone"
            tools:itemCount="2"
            tools:listitem="@layout/item_izleme_listesi_film"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvSonucYok"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/watchlist_stat_card"
            android:gravity="center"
            android:padding="20dp"
            android:textColor="@color/wl_text_muted"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="“matrix” ile eşleşen film yok." />

        <!-- ====== İSTATİSTİKLER ====== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.06"
                android:text="İSTATİSTİKLER"
                android:textColor="@color/wl_label"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvIstatistikDurum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/wl_purple_light"
                android:textSize="12sp"
                tools:text="Bu Hafta Güncel" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Toplam Film -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/watchlist_stat_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="6dp"
                android:paddingVertical="14dp">

                <TextView
                    android:id="@+id/tvToplamFilm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/wl_indigo"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="Toplam Film"
                    android:textColor="@color/wl_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvToplamFilmAlt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/watchlist_pill_neutral"
                    android:maxLines="1"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="0 saat"
                    android:textColor="@color/wl_text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Bu Ay -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp"
                android:layout_weight="1"
                android:background="@drawable/watchlist_stat_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="6dp"
                android:paddingVertical="14dp">

                <TextView
                    android:id="@+id/tvBuAy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/wl_pink"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="Bu Ay"
                    android:textColor="@color/wl_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBuAyAlt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/watchlist_pill_pink"
                    android:maxLines="1"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="+0 bugün"
                    android:textColor="@color/wl_pink"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Bu Hafta -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/watchlist_stat_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="6dp"
                android:paddingVertical="14dp">

                <TextView
                    android:id="@+id/tvBuHafta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/wl_green"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="Bu Hafta"
                    android:textColor="@color/wl_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBuHaftaAlt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/watchlist_pill_green"
                    android:maxLines="1"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="Seri: 0 gün"
                    android:textColor="@color/wl_green"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ====== LİSTE YÖNETİMİ ====== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.06"
            android:text="LİSTE YÖNETİMİ"
            android:textColor="@color/wl_label"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Listeyi Temizle -->
        <LinearLayout
            android:id="@+id/rowListeyiTemizle"
            style="@style/Widget.FilmSwipe.Watchlist.Row"
            android:layout_marginTop="10dp">

            <ImageView
                style="@style/Widget.FilmSwipe.Watchlist.RowIcon"
                android:background="@drawable/watchlist_row_icon_red"
                android:src="@drawable/ic_wl_trash"
                app:tint="@color/wl_red" />

            <LinearLayout style="@style/Widget.FilmSwipe.Watchlist.RowTexts">

                <TextView
                    style="@style/Widget.FilmSwipe.Watchlist.RowTitle"
                    android:text="Listeyi Temizle" />

                <TextView
                    style="@style/Widget.FilmSwipe.Watchlist.RowSubtitle"
                    android:text="Tüm kayıtlı film verilerini sıfırla" />
            </LinearLayout>

            <ImageView style="@style/Widget.FilmSwipe.Watchlist.RowChevron" />
        </LinearLayout>

        <!-- Listeyi Paylaş -->
        <LinearLayout
            android:id="@+id/rowListeyiPaylas"
            style="@style/Widget.FilmSwipe.Watchlist.Row"
            android:layout_marginTop="8dp">

            <ImageView
                style="@style/Widget.FilmSwipe.Watchlist.RowIcon"
                android:background="@drawable/watchlist_row_icon_amber"
                android:src="@drawable/ic_wl_upload"
                app:tint="@color/wl_amber" />

            <LinearLayout style="@style/Widget.FilmSwipe.Watchlist.RowTexts">

                <TextView
                    style="@style/Widget.FilmSwipe.Watchlist.RowTitle"
                    android:text="Listeyi Paylaş" />

                <TextView
                    style="@style/Widget.FilmSwipe.Watchlist.RowSubtitle"
                    android:text="Arkadaşlarınla ortak link veya hikaye üret" />
            </LinearLayout>

            <ImageView style="@style/Widget.FilmSwipe.Watchlist.RowChevron" />
        </LinearLayout>

        <!-- Film Odasına Davet Et -->
        <LinearLayout
            android:id="@+id/rowFilmOdasinaDavetEt"
            style="@style/Widget.FilmSwipe.Watchlist.Row"
            android:layout_marginTop="8dp">

            <ImageView
                style="@style/Widget.FilmSwipe.Watchlist.RowIcon"
                android:background="@drawable/watchlist_row_icon_purple"
                android:src="@drawable/ic_wl_person_add"
                app:tint="@color/wl_purple_light" />

            <LinearLayout style="@style/Widget.FilmSwipe.Watchlist.RowTexts">

                <TextView
                    style="@style/Widget.FilmSwipe.Watchlist.RowTitle"
                    android:text="Film Odasına Davet Et" />

                <TextView
                    style="@style/Widget.FilmSwipe.Watchlist.RowSubtitle"
                    android:text="Oda kur, kodu arkadaşınla paylaş" />
            </LinearLayout>

            <ImageView style="@style/Widget.FilmSwipe.Watchlist.RowChevron" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
