<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/watchlist_stat_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- Film Posteri -->
    <androidx.cardview.widget.CardView
        android:layout_width="54dp"
        android:layout_height="78dp"
        app:cardBackgroundColor="@color/wl_neutral_surface"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/imgFilmPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            tools:src="@drawable/placeholder_movie_poster" />
    </androidx.cardview.widget.CardView>

    <!-- Film Bilgileri -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvFilmAdi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/wl_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Yıldızlararası" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvFilmYili"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/wl_text_muted"
                android:textSize="12sp"
                tools:text="2014" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="6dp"
                android:text="•"
                android:textColor="@color/wl_text_muted"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wl_star"
                app:tint="@color/wl_gold" />

            <TextView
                android:id="@+id/tvFilmPuani"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:textColor="@color/wl_gold"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="8.4" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEklemeTarihi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/watchlist_pill_neutral"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="@color/wl_text_muted"
            android:textSize="10.5sp"
            tools:text="Eklendi • Bugün" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnKaldir"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/watchlist_delete_button"
        android:contentDescription="@string/watchlist_remove_movie"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_wl_trash"
        app:tint="@color/wl_red" />

</LinearLayout>
