<?xml version="1.0" encoding="utf-8"?>
<!-- Aktif mesajlaşma ekranı -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_light"
    android:orientation="vertical"
    tools:context=".fragments.SohbetFragment">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_background"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:elevation="4dp">

        <!-- Back Button -->
        <Button
            android:id="@+id/btnGeri"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:text="←"
            android:textColor="@color/text_white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Title Section -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Film Hakkında Sohbet"
                android:textColor="@color/text_white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEslesenFilmBaslik"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="The Amazing Movie"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:alpha="0.9" />

        </LinearLayout>

        <!-- Menu Button -->
        <Button
            android:id="@+id/btnMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:text="⋮"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Messages RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:clipToPadding="false"
        android:background="@color/bg_light" />

    <!-- Message Input Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_light"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:elevation="8dp">

        <!-- Message Input Container -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/card_background"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:layout_marginEnd="12dp">

            <EditText
                android:id="@+id/etMesaj"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Mesajınızı yazın..."
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:maxLines="3"
                android:inputType="textCapSentences|textMultiLine" />

        </LinearLayout>

        <!-- Send Button -->
        <Button
            android:id="@+id/btnGonder"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/button_primary"
            android:elevation="6dp"
            android:text="➤"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>