<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:elevation="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/film_poster_background">

        <!-- Film Poster Image -->
        <ImageView
            android:id="@+id/imageViewFilmPoster"
            android:layout_width="105dp"
            android:layout_height="140dp"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_movie_poster"
            android:background="@drawable/poster_shadow"
            android:contentDescription="Film Posteri" />

        <!-- Film Info Overlay -->
        <LinearLayout
            android:layout_width="105dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="6dp"
            android:background="@drawable/film_info_gradient">

            <!-- Film Title -->
            <TextView
                android:id="@+id/textViewFilmTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/movie_name"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginBottom="2dp" />

            <!-- Rating -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐"
                    android:textSize="9sp"
                    android:layout_marginEnd="3dp" />

                <TextView
                    android:id="@+id/textViewFilmRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8.5"
                    android:textColor="#FFD700"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

            </LinearLayout>

        </LinearLayout>

        <!-- Popularity Badge -->
        <TextView
            android:id="@+id/textViewPopularityBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hot_badge"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/popularity_badge"
            android:paddingHorizontal="5dp"
            android:paddingVertical="2dp"
            android:layout_margin="5dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-130dp"
            android:layout_marginEnd="5dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
