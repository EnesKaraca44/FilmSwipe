<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <!-- Film Kartı -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardFilm"
        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_margin="24dp"
        android:elevation="12dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/surface_light">

            <!-- Film Posteri -->
            <ImageView
                android:id="@+id/ivFilmPoster"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_background"
                android:background="@color/bg_medium" />

            <!-- Film Bilgileri -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvFilmAdi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Örnek Film Adı"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tvFilmYili"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📅 2023"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:layout_marginEnd="16dp" />

                    <TextView
                        android:id="@+id/tvFilmTuru"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎭 Komedi"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvFilmPuani"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐ 8.5/10"
                    android:textColor="@color/accent_medium"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvFilmOzet"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="Film özeti buraya gelecek..."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:maxLines="4"
                    android:ellipsize="end"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>