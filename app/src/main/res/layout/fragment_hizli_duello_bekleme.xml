<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/light_gradient_background"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    tools:context=".fragments.HizliDuelloBeklemeFragment">

    <!-- Ana Animasyon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_background"
        android:elevation="8dp"
        android:padding="40dp"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡"
            android:textSize="64sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hızlı Düello"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Partner aranıyor..."
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

        <!-- Loading Animation -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:indeterminateTint="@color/primary_light" />

    </LinearLayout>

    <!-- Bekleme Durumu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="32dp">

        <TextView
            android:id="@+id/tvBeklemeZamani"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:15"
            android:textColor="@color/primary_medium"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏰ Bekleme süresi"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:alpha="0.8"
            android:layout_marginBottom="16dp" />

        <!-- Online Kullanıcı Sayısı -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_accent"
            android:padding="12dp"
            android:elevation="4dp"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👥 "
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvOnlineKullanici"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12 kişi çevrimiçi"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- Bilgi Bölümü -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💡 Nasıl Çalışır?"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Sistem seni başka bir kullanıcıyla eşleştirir\n• Popüler filmler arasından seçim yaparsınız\n• Hızlı ve eğlenceli deneyim!"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:alpha="0.9"
            android:gravity="center"
            android:lineSpacingExtra="6dp" />

    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- İptal Button -->
        <Button
            android:id="@+id/btnIptal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/button_secondary"
            android:elevation="6dp"
            android:text="❌ İptal Et"
            android:textColor="@color/text_white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Ana Menü Button -->
        <Button
            android:id="@+id/btnAnaMenu"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/text_hint"
            android:elevation="2dp"
            android:text="🏠 Ana Menü"
            android:textColor="@color/text_white"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>