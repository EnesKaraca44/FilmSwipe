<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== Listem > "Liste Yönetimi" satırları ===== -->
    <style name="Widget.FilmSwipe.Watchlist.Row" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">66dp</item>
        <item name="android:background">@drawable/watchlist_management_card</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="Widget.FilmSwipe.Watchlist.RowIcon" parent="">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="Widget.FilmSwipe.Watchlist.RowTexts" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Widget.FilmSwipe.Watchlist.RowTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/wl_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.FilmSwipe.Watchlist.RowSubtitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/wl_text_muted</item>
        <item name="android:textSize">11.5sp</item>
    </style>

    <style name="Widget.FilmSwipe.Watchlist.RowChevron" parent="">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:src">@drawable/ic_wl_chevron_right</item>
        <item name="tint">@color/wl_text_muted</item>
    </style>

    <!-- ===== Alt menü: seçili sekmenin arkasındaki mor hap ===== -->
    <style name="Widget.FilmSwipe.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/wl_purple_surface</item>
        <item name="android:width">64dp</item>
        <item name="android:height">32dp</item>
    </style>

    <style name="TextAppearance.FilmSwipe.BottomNav.Active" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textStyle">bold</item>
    </style>

</resources>
